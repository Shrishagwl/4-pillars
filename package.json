{
  "name": "4-pillars",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "templates/fastify-service",
    "services/ingest-api",
    "services/telstra-gateway",
    "services/telstra-fake",
    "apps/dashboard"
  ],
  "scripts": {
    "postinstall": "npm run build -w @4p/contracts",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
