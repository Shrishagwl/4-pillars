# Copy to .env for local overrides. Never commit real values.
# Docker Compose reads .env automatically.

POSTGRES_PASSWORD=pillars-local
LOG_LEVEL=info

# Telstra credentials (only needed once we switch telstra-gateway to the real sandbox, #36).
# In the cloud these live in Secret Manager, not in env files.
TELSTRA_CLIENT_ID=
TELSTRA_CLIENT_SECRET=
